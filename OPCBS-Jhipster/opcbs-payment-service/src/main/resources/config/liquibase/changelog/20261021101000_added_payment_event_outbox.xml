<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="20261021101000-payment-event-outbox" author="opcbs">
        <createTable tableName="payment_event_outbox">
            <column name="id" type="bigint" autoIncrement="true"><constraints primaryKey="true" nullable="false"/></column>
            <column name="event_id" type="varchar(100)"><constraints nullable="false" unique="true" uniqueConstraintName="ux_payment_outbox_event"/></column>
            <column name="event_type" type="varchar(80)"><constraints nullable="false"/></column>
            <column name="aggregate_key" type="varchar(100)"><constraints nullable="false"/></column>
            <column name="payload" type="longtext"><constraints nullable="false"/></column>
            <column name="status" type="varchar(20)" defaultValue="PENDING"><constraints nullable="false"/></column>
            <column name="retry_count" type="int" defaultValueNumeric="0"><constraints nullable="false"/></column>
            <column name="next_retry_at" type="datetime(6)"/>
            <column name="created_at" type="datetime(6)" defaultValueComputed="CURRENT_TIMESTAMP(6)"><constraints nullable="false"/></column>
            <column name="sent_at" type="datetime(6)"/>
            <column name="error_message" type="varchar(1000)"/>
        </createTable>
        <createIndex tableName="payment_event_outbox" indexName="ix_payment_outbox_dispatch">
            <column name="status"/><column name="next_retry_at"/><column name="created_at"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
