{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "opcbs": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        },
        "@schematics/angular:application": {
          "strict": true
        }
      },
      "root": "",
      "sourceRoot": "src/main/webapp",
      "prefix": "jhi",
      "architect": {
        "build": {
          "builder": ".:native-federation",
          "options": {
            "tsConfig": "tsconfig.federation.json",
            "federationConfigPath": "federation.config.ts",
            "entryPoints": ["src/main/webapp/main.ts"],
            "cacheExternalArtifacts": true
          },
          "configurations": {
            "production": {
              "target": "opcbs:esbuild:production"
            },
            "development": {
              "target": "opcbs:esbuild:development",
              "dev": true
            }
          },
          "defaultConfiguration": "production"
        },
        "esbuild": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": {
              "base": "target/classes/static/",
              "browser": "",
              "server": "node-server",
              "media": "resources"
            },
            "index": "src/main/webapp/index.html",
            "browser": "src/main/webapp/main.ts",
            "polyfills": ["es-module-shims", "@angular/localize/init"],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "src/main/webapp/content",
              "src/main/webapp/videos",
              "src/main/webapp/favicon.ico",
              "src/main/webapp/manifest.webapp",
              "src/main/webapp/robots.txt",
              "src/main/webapp/swagger-ui"
            ],
            "styles": ["src/main/webapp/content/scss/vendor.scss", "src/main/webapp/content/scss/global.scss"],
            "scripts": [],
            "define": {
              "SERVER_API_URL": "''"
            }
          },
          "configurations": {
            "production": {
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": true
                },
                "fonts": {
                  "inline": false
                }
              },
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": true,
              "extractLicenses": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2mb",
                  "maximumError": "5mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "30kb",
                  "maximumError": "50kb"
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true,
              "fileReplacements": [
                {
                  "replace": "src/main/webapp/environments/environment.ts",
                  "with": "src/main/webapp/environments/environment.development.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": ".:native-federation",
          "options": {
            "target": "opcbs:serve-original:development",
            "tsConfig": "tsconfig.federation.json",
            "federationConfigPath": "federation.config.ts",
            "entryPoints": ["src/main/webapp/main.ts"],
            "rebuildDelay": 500,
            "cacheExternalArtifacts": true,
            "dev": true,
            "devServer": true,
            "port": 0
          },
          "configurations": {
            "production": {
              "target": "opcbs:serve-original:production"
            },
            "development": {
              "target": "opcbs:serve-original:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "serve-original": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "opcbs:esbuild:development",
            "open": true,
            "proxyConfig": "proxy.config.mjs",
            "port": 4200
          },
          "configurations": {
            "production": {
              "buildTarget": "opcbs:esbuild:production"
            },
            "development": {
              "buildTarget": "opcbs:esbuild:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "runner": "vitest",
            "buildTarget": "opcbs:esbuild:development",
            "runnerConfig": true,
            "coverageReporters": ["text", "lcov"],
            "reporters": ["default", ["vitest-sonar-reporter", { "outputFile": "./target/test-results/TESTS-results-sonar-vitest.xml" }]],
            "watch": false,
            "tsConfig": "tsconfig.spec.json"
          }
        }
      }
    }
  },
  "cli": {
    "cache": {
      "enabled": true,
      "path": "./target/angular/",
      "environment": "all"
    },
    "packageManager": "npm",
    "analytics": "e3187706-b001-4984-a04e-d3b0833b6508"
  }
}
