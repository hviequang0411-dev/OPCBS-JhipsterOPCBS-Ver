<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Added the entity DoctorVerification (Quản lý và duyệt chứng chỉ hành nghề bác sĩ).
    -->
    <changeSet id="20261022130000-1" author="mindbridge">
        <createTable tableName="doctor_verification" remarks="Quản lý hồ sơ xác thực và duyệt chứng chỉ hành nghề bác sĩ">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="doctor_profile_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="doctor_name" type="varchar(160)">
                <constraints nullable="true"/>
            </column>
            <column name="license_number" type="varchar(100)">
                <constraints nullable="true"/>
            </column>
            <column name="specialization" type="varchar(150)">
                <constraints nullable="true"/>
            </column>
            <column name="experience_years" type="integer">
                <constraints nullable="true"/>
            </column>
            <column name="education" type="varchar(255)">
                <constraints nullable="true"/>
            </column>
            <column name="status" type="varchar(50)" defaultValue="DRAFT">
                <constraints nullable="false"/>
            </column>
            <column name="notes" type="${clobType}">
                <constraints nullable="true"/>
            </column>
            <column name="certificate_url" type="varchar(500)">
                <constraints nullable="true"/>
            </column>
            <column name="certificate_public_id" type="varchar(200)">
                <constraints nullable="true"/>
            </column>
            <column name="certificate_file_name" type="varchar(255)">
                <constraints nullable="true"/>
            </column>
            <column name="certificate_content_type" type="varchar(100)">
                <constraints nullable="true"/>
            </column>
            <column name="certificate_uploaded_at" type="${datetimeType}">
                <constraints nullable="true"/>
            </column>
            <column name="submitted_at" type="${datetimeType}">
                <constraints nullable="true"/>
            </column>
            <column name="reviewed_at" type="${datetimeType}">
                <constraints nullable="true"/>
            </column>
            <column name="reviewed_by" type="varchar(100)">
                <constraints nullable="true"/>
            </column>
            <column name="rejection_reason" type="${clobType}">
                <constraints nullable="true"/>
            </column>
            <column name="created_at" type="${datetimeType}">
                <constraints nullable="true"/>
            </column>
            <column name="updated_at" type="${datetimeType}">
                <constraints nullable="true"/>
            </column>
        </createTable>

        <createIndex indexName="idx_doc_verif_doc_id" tableName="doctor_verification">
            <column name="doctor_profile_id"/>
        </createIndex>
        <createIndex indexName="idx_doc_verif_status" tableName="doctor_verification">
            <column name="status"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="doctor_profile_id"
                                 baseTableName="doctor_verification"
                                 constraintName="fk_doc_verif__doctor_profile_id"
                                 referencedColumnNames="id"
                                 referencedTableName="doctor_profile"
                                 onDelete="CASCADE"/>
    </changeSet>

