# ==============================================================================
# MySQL 8.4 Enterprise High-Concurrency Tuning for MindBridge OPCBS (1,000+ Users)
# ==============================================================================
[mysqld]
# 1. Connection & Thread Handling
max_connections                = 500
max_user_connections           = 450
thread_cache_size              = 64
max_connect_errors             = 10000
interactive_timeout            = 28800
wait_timeout                   = 28800

# 2. InnoDB Buffer Pool & Memory Sizing
innodb_buffer_pool_size        = 1G
innodb_buffer_pool_instances  = 4
innodb_redo_log_capacity       = 512M
innodb_log_buffer_size         = 32M
innodb_flush_log_at_trx_commit = 2       # Tối ưu hóa I/O: flush disk mỗi giây, cực nhanh cho transaction
innodb_flush_method            = O_DIRECT
innodb_file_per_table          = 1
innodb_stats_on_metadata       = 0

# 3. Concurrency & Deadlock Prevention
innodb_thread_concurrency      = 0       # Để InnoDB tự điều tiết theo số Core CPU
innodb_lock_wait_timeout       = 30      # Giảm timeout chờ lock để nhanh chóng phát hiện race condition
innodb_print_all_deadlocks     = 1       # Ghi log toàn bộ deadlock ra error log để truy vết

# 4. Character Set & Collation Chuẩn Y Khoa Tiếng Việt
character-set-server           = utf8mb4
collation-server               = utf8mb4_unicode_ci

# 5. Query Optimization & Temporary Tables
tmp_table_size                 = 64M
max_heap_table_size            = 64M
join_buffer_size               = 4M
sort_buffer_size               = 4M
read_rnd_buffer_size           = 2M
