# ==============================================================================
# Environment Configuration Template for MindBridge OPCBS Production Docker
# ==============================================================================
# INSTRUCTIONS:
# Copy this file to '.env' and replace all placeholders (<...>) with real values.
# NEVER commit the actual '.env' file containing real secrets to Git!
# ==============================================================================

# Database Credentials
DB_NAME=opcbs
DB_USER=opcbs_user
DB_PASSWORD=<CHANGE_ME_STRONG_DB_PASSWORD>
DB_ROOT_PASSWORD=<CHANGE_ME_STRONG_ROOT_PASSWORD>

# Redis Credentials (JWT Blacklist & Auth Token Store - Persistent, noeviction policy)
# Note: Container opcbs-redis-prod persists to volume redis-data and uses noeviction so revoked JWTs are NEVER evicted.
REDIS_PASSWORD=<CHANGE_ME_STRONG_REDIS_PASSWORD>

# Redis Cache Credentials (Dashboard & Application Query Cache - Transient, allkeys-lru policy)
# Note: Container opcbs-redis-cache-prod is in-memory only (save ""), allkeys-lru eviction.
# Container environment dynamically passes REDIS_CACHE_PASSWORD to healthcheck for exact authentication.
REDIS_CACHE_PASSWORD=<CHANGE_ME_STRONG_REDIS_CACHE_PASSWORD>

# ==============================================================================
# JWT Authentication - RSA RS256 Key Configuration
# ==============================================================================
# In RS256, ONLY opcbs-auth-service requires the RSA Private Key to sign tokens.
# All verifying services fetch the Public Key dynamically via JWKS endpoint or mount.
#
# To generate a production-ready 2048-bit RSA key pair:
#   mkdir -p ./secrets/jwt
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out ./secrets/jwt/private.pem
#   openssl rsa -pubout -in ./secrets/jwt/private.pem -out ./secrets/jwt/public.pem
#   chmod 600 ./secrets/jwt/private.pem
#   chmod 644 ./secrets/jwt/public.pem
#
# Local directory on host containing the RSA private key:
JWT_SECRET_DIR=./secrets/jwt
# Path inside opcbs-auth-service container:
JWT_PRIVATE_KEY_PATH=/secrets/jwt/private.pem
# Alternatively, inline Base64/PEM string (if using secrets manager):
JWT_PRIVATE_KEY=
# Active Key ID in JWT header:
JWT_KEY_ID=opcbs-jwt-key-prod-1
# JWKS Endpoint for verifying services:
JWT_JWK_SET_URI=http://opcbs-auth-service:8081/.well-known/jwks.json
# Optional mounted public key for verifying services (offline mode):
JWT_PUBLIC_KEY_PATH=
JWT_PUBLIC_KEY=

# Mail Service Credentials (SMTP)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=<YOUR_EMAIL_ADDRESS_OR_SMTP_USER>
SPRING_MAIL_PASSWORD=<YOUR_SMTP_APP_PASSWORD>
SPRING_MAIL_FROM=<YOUR_SENDER_EMAIL_ADDRESS>

# Cloudinary Cloud Storage Credentials (Doctor certificates & avatars)
CLOUDINARY_CLOUD_NAME=<YOUR_CLOUDINARY_CLOUD_NAME>
CLOUDINARY_API_KEY=<YOUR_CLOUDINARY_API_KEY>
CLOUDINARY_API_SECRET=<YOUR_CLOUDINARY_API_SECRET>

# VNPay Payment Gateway Credentials
VNPAY_TMN_CODE=<YOUR_VNPAY_TMN_CODE>
VNPAY_HASH_SECRET=<YOUR_VNPAY_HASH_SECRET>
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# Domain & Host Configuration
VIRTUAL_HOST=localhost
NGINX_PORT=80
NGINX_SSL_PORT=443

# WebSocket CORS Allowed Origins
# Mandatory: Comma-separated list of exact allowed origins permitted to establish WebSocket/STOMP connections.
# SECURITY REQUIREMENT: Never use '*' wildcard in production!
# In local development: defaults to http://localhost,https://localhost,http://localhost:9000,http://localhost:80
# In production: MUST be configured with exact production frontend domains including scheme and port (if non-standard),
# e.g.: WS_ALLOWED_ORIGINS=https://mindbridge.vn,https://www.mindbridge.vn,http://localhost
WS_ALLOWED_ORIGINS=http://localhost,https://localhost,http://localhost:9000,http://localhost:80

# Apache Kafka KRaft Event Broker Configuration
# Note: Single-node KRaft broker suited for initial phase.
# Architectural note: If the single broker temporarily experiences downtime, the Transactional Outbox pattern
# in Booking service safely retains pending events in MySQL and automatically relays them once broker recovers.
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
APPLICATION_KAFKA_ENABLED=true
KAFKA_MEM_LIMIT=1024M
KAFKA_CPU_LIMIT=1.0

# RabbitMQ Task Broker Configuration (Email dispatch worker queues & Dead-Letter Exchanges)
RABBITMQ_DEFAULT_USER=opcbs_rabbit
RABBITMQ_DEFAULT_PASS=GENERATE_A_UNIQUE_LONG_RANDOM_SECRET
APPLICATION_RABBITMQ_ENABLED=true
RABBITMQ_MEM_LIMIT=512M
RABBITMQ_CPU_LIMIT=1.0

# Global Infrastructure Quotas
MYSQL_MEM_LIMIT=2048M
MYSQL_CPU_LIMIT=2.0
REDIS_MEM_LIMIT=512M
REDIS_CPU_LIMIT=1.0

# Microservices Resource Quotas
AUTH_SERVICE_MEM_LIMIT=1024M
AUTH_SERVICE_CPU_LIMIT=1.5
BOOKING_SERVICE_MEM_LIMIT=1536M
BOOKING_SERVICE_CPU_LIMIT=2.0
CLINICAL_SERVICE_MEM_LIMIT=768M
CLINICAL_SERVICE_CPU_LIMIT=1.0
TREATMENT_SERVICE_MEM_LIMIT=512M
TREATMENT_SERVICE_CPU_LIMIT=0.75
PSYCHOMETRIC_SERVICE_MEM_LIMIT=512M
PSYCHOMETRIC_SERVICE_CPU_LIMIT=0.75
NOTIFICATION_SERVICE_MEM_LIMIT=768M
NOTIFICATION_SERVICE_CPU_LIMIT=1.0
PAYMENT_SERVICE_MEM_LIMIT=512M
PAYMENT_SERVICE_CPU_LIMIT=0.75
MESSAGE_SERVICE_MEM_LIMIT=512M
MESSAGE_SERVICE_CPU_LIMIT=0.75
BLOG_SERVICE_MEM_LIMIT=512M
BLOG_SERVICE_CPU_LIMIT=0.75
FRONTEND_MEM_LIMIT=256M
FRONTEND_CPU_LIMIT=0.5
