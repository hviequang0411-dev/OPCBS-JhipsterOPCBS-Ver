<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

    <changeSet id="20261001122000-1" author="mindbridge">
        <createTable tableName="psychometric_test">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="title" type="varchar(255)">
                <constraints nullable="false" />
            </column>
            <column name="description" type="${clobType}"/>
            <column name="test_type" type="varchar(50)">
                <constraints nullable="false" />
            </column>
            <column name="category" type="varchar(100)"/>
            <column name="purpose" type="${clobType}"/>
            <column name="score_ranges_json" type="${clobType}"/>
            <column name="source_url" type="varchar(500)"/>
            <column name="is_active" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false" />
            </column>
            <column name="doctor_id" type="bigint"/>
            <column name="created_by" type="varchar(50)"/>
            <column name="created_date" type="${datetimeType}"/>
            <column name="last_modified_by" type="varchar(50)"/>
            <column name="last_modified_date" type="${datetimeType}"/>
        </createTable>

        <addForeignKeyConstraint baseColumnNames="doctor_id"
                                 baseTableName="psychometric_test"
                                 constraintName="fk_psychometric_test__doctor_id"
                                 referencedColumnNames="id"
                                 referencedTableName="doctor_profile"/>

        <createTable tableName="psychometric_question">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="test_id" type="bigint">
                <constraints nullable="false" />
            </column>
            <column name="question_text" type="${clobType}">
                <constraints nullable="false" />
            </column>
            <column name="question_number" type="int">
                <constraints nullable="false" />
            </column>
            <column name="category" type="varchar(100)"/>
            <column name="question_type" type="varchar(50)" defaultValue="Rating0To3">
                <constraints nullable="false" />
            </column>
            <column name="options_json" type="${clobType}"/>
            <column name="created_by" type="varchar(50)"/>
            <column name="created_date" type="${datetimeType}"/>
            <column name="last_modified_by" type="varchar(50)"/>
            <column name="last_modified_date" type="${datetimeType}"/>
        </createTable>

        <addForeignKeyConstraint baseColumnNames="test_id"
                                 baseTableName="psychometric_question"
                                 constraintName="fk_psychometric_question__test_id"
                                 referencedColumnNames="id"
                                 referencedTableName="psychometric_test"/>

        <createTable tableName="psychometric_submission">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="test_id" type="bigint">
                <constraints nullable="false" />
            </column>
            <column name="patient_id" type="bigint">
                <constraints nullable="false" />
            </column>
            <column name="assigned_by_doctor_id" type="bigint"/>
            <column name="appointment_id" type="bigint"/>
            <column name="total_score" type="int" defaultValueNumeric="0">
                <constraints nullable="false" />
            </column>
            <column name="score_data_json" type="${clobType}"/>
            <column name="interpretation" type="${clobType}"/>
            <column name="doctor_notes" type="${clobType}"/>
            <column name="due_date" type="${datetimeType}"/>
            <column name="status" type="varchar(50)" defaultValue="COMPLETED">
                <constraints nullable="false" />
            </column>
            <column name="completed_at" type="${datetimeType}"/>
            <column name="created_by" type="varchar(50)"/>
            <column name="created_date" type="${datetimeType}"/>
            <column name="last_modified_by" type="varchar(50)"/>
            <column name="last_modified_date" type="${datetimeType}"/>
        </createTable>

        <addForeignKeyConstraint baseColumnNames="test_id"
                                 baseTableName="psychometric_submission"
                                 constraintName="fk_psychometric_submission__test_id"
                                 referencedColumnNames="id"
                                 referencedTableName="psychometric_test"/>

        <addForeignKeyConstraint baseColumnNames="patient_id"
                                 baseTableName="psychometric_submission"
                                 constraintName="fk_psychometric_submission__patient_id"
                                 referencedColumnNames="id"
                                 referencedTableName="patient_profile"/>

        <addForeignKeyConstraint baseColumnNames="assigned_by_doctor_id"
                                 baseTableName="psychometric_submission"
                                 constraintName="fk_psychometric_submission__doctor_id"
                                 referencedColumnNames="id"
                                 referencedTableName="doctor_profile"/>

        <createTable tableName="psychometric_answer">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="submission_id" type="bigint">
                <constraints nullable="false" />
            </column>
            <column name="question_id" type="bigint">
                <constraints nullable="false" />
            </column>
            <column name="score" type="int" defaultValueNumeric="0">
                <constraints nullable="false" />
            </column>
            <column name="answer_text" type="${clobType}"/>
            <column name="created_by" type="varchar(50)"/>
            <column name="created_date" type="${datetimeType}"/>
            <column name="last_modified_by" type="varchar(50)"/>
            <column name="last_modified_date" type="${datetimeType}"/>
        </createTable>

        <addForeignKeyConstraint baseColumnNames="submission_id"
                                 baseTableName="psychometric_answer"
                                 constraintName="fk_psychometric_answer__submission_id"
                                 referencedColumnNames="id"
                                 referencedTableName="psychometric_submission"/>

        <addForeignKeyConstraint baseColumnNames="question_id"
                                 baseTableName="psychometric_answer"
                                 constraintName="fk_psychometric_answer__question_id"
                                 referencedColumnNames="id"
                                 referencedTableName="psychometric_question"/>
    </changeSet>

