{
  "info": {
    "name": "MindBridge OPCBS - API Test Payloads & Collection",
    "description": "Bộ mẫu dữ liệu JSON và thông tin endpoint hoàn chỉnh để kiểm thử toàn bộ 43 REST APIs của hệ thống OPCBS qua Postman / Thunder Client / cURL / REST Client",
    "baseUrl": "http://localhost:8081",
    "authHeaderTemplate": "Authorization: Bearer <JWT_TOKEN>"
  },
  "environments": {
    "local": {
      "baseUrl": "http://localhost:8081",
      "defaultPassword": "user",
      "adminPassword": "admin"
    }
  },
  "endpoints": [
    {
      "group": "1. Authentication & Account",
      "tests": [
        {
          "name": "1.1. Đăng nhập Bác sĩ (Login as Doctor)",
          "method": "POST",
          "url": "{{baseUrl}}/api/authenticate",
          "headers": {
            "Content-Type": "application/json"
          },
          "body": {
            "username": "doctor1",
            "password": "user",
            "rememberMe": true
          },
          "expectedStatus": 200,
          "notes": "Trả về id_token (JWT Token). Dùng token này để gắn vào Header Authorization cho các API cần quyền ROLE_DOCTOR."
        },
        {
          "name": "1.2. Đăng nhập Bệnh nhân (Login as Patient)",
          "method": "POST",
          "url": "{{baseUrl}}/api/authenticate",
          "headers": {
            "Content-Type": "application/json"
          },
          "body": {
            "username": "patient1",
            "password": "user",
            "rememberMe": true
          },
          "expectedStatus": 200,
          "notes": "Trả về id_token của bệnh nhân để gọi các API đặt lịch, làm bài test, xem bệnh án."
        },
        {
          "name": "1.3. Đăng nhập Quản trị viên (Login as Admin)",
          "method": "POST",
          "url": "{{baseUrl}}/api/authenticate",
          "headers": {
            "Content-Type": "application/json"
          },
          "body": {
            "username": "admin",
            "password": "admin",
            "rememberMe": true
          },
          "expectedStatus": 200
        },
        {
          "name": "1.4. Đăng ký tài khoản Bệnh nhân mới",
          "method": "POST",
          "url": "{{baseUrl}}/api/register",
          "headers": {
            "Content-Type": "application/json"
          },
          "body": {
            "login": "new_patient_01",
            "email": "new_patient_01@example.com",
            "password": "user1234",
            "langKey": "vi"
          },
          "expectedStatus": 201
        },
        {
          "name": "1.5. Lấy thông tin tài khoản hiện tại (Profile)",
          "method": "GET",
          "url": "{{baseUrl}}/api/account",
          "headers": {
            "Authorization": "Bearer <JWT_TOKEN>"
          },
          "body": null,
          "expectedStatus": 200
        }
      ]
    },
    {
      "group": "2. Doctor Schedule & Availability Slots",
      "tests": [
        {
          "name": "2.1. Bác sĩ xem danh sách Slot của mình (My Slots)",
          "method": "GET",
          "url": "{{baseUrl}}/api/doctor/my-slots?page=0&size=50&sort=startTime,asc",
          "headers": {
            "Authorization": "Bearer <DOCTOR_JWT_TOKEN>"
          },
          "body": null,
          "expectedStatus": 200
        },
        {
          "name": "2.2. Bác sĩ tạo 1 khung giờ rảnh đơn lẻ (Create Slot)",
          "method": "POST",
          "url": "{{baseUrl}}/api/doctor/slots",
          "headers": {
            "Content-Type": "application/json",
            "Authorization": "Bearer <DOCTOR_JWT_TOKEN>"
          },
          "body": {
            "startTime": "2026-10-05T08:30:00Z",
            "endTime": "2026-10-05T09:30:00Z",
            "consultationMode": "ONLINE",
            "notes": "Tư vấn trực tuyến qua Google Meet"
          },
          "expectedStatus": 201
        },
        {
          "name": "2.3. Bác sĩ tạo lịch rảnh hàng loạt theo tuần (Batch Generate Slots)",
          "method": "POST",
          "url": "{{baseUrl}}/api/doctor/slots/batch",
          "headers": {
            "Content-Type": "application/json",
            "Authorization": "Bearer <DOCTOR_JWT_TOKEN>"
          },
          "body": {
            "startDate": "2026-10-05",
            "endDate": "2026-10-09",
            "dailyStartTime": "08:00",
            "dailyEndTime": "17:00",
            "slotDurationMinutes": 60,
            "daysOfWeek": [1, 2, 3, 4, 5],
            "consultationMode": "ONLINE",
            "notes": "Lịch làm việc cố định trong tuần"
          },
          "expectedStatus": 201,
          "notes": "Tự động sinh các slot rảnh 60 phút từ Thứ 2 đến Thứ 6."
        },
        {
          "name": "2.4. Bác sĩ cập nhật thông tin Slot",
          "method": "PUT",
          "url": "{{baseUrl}}/api/doctor/slots/1",
          "headers": {
            "Content-Type": "application/json",
            "Authorization": "Bearer <DOCTOR_JWT_TOKEN>"
          },
          "body": {
            "id": 1,
            "startTime": "2026-10-05T09:00:00Z",
            "endTime": "2026-10-05T10:00:00Z",
            "status": "AVAILABLE",
            "consultationMode": "IN_PERSON",
            "notes": "Khám trực tiếp tại phòng khám MindBridge Quận 1"
          },
          "expectedStatus": 200
        },
        {
          "name": "2.5. Bác sĩ bật/tắt nhanh trạng thái Slot (Toggle Status)",
          "method": "PUT",
          "url": "{{baseUrl}}/api/doctor/slots/1/toggle-status",
          "headers": {
            "Authorization": "Bearer <DOCTOR_JWT_TOKEN>"
          },
          "body": null,
          "expectedStatus": 200,
          "notes": "Chuyển đổi trạng thái giữa AVAILABLE <-> UNAVAILABLE."
        },
        {
          "name": "2.6. Bác sĩ xóa Slot chưa có người đặt",
          "method": "DELETE",
          "url": "{{baseUrl}}/api/doctor/slots/1",
          "headers": {
            "Authorization": "Bearer <DOCTOR_JWT_TOKEN>"
          },
          "body": null,
          "expectedStatus": 204
        }
      ]
    },
    {
      "group": "3. Patient Booking & Appointment Management",
